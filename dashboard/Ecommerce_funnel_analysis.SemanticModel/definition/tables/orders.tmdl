table orders
	lineageTag: 87438ded-2e23-4b86-8fd0-5f30a5ca3563

	measure 'Total Orders' = DISTINCTCOUNT('orders'[order_id])
		formatString: 0
		lineageTag: 8d140a10-f63d-46c8-bc7a-167e2cf4688c

	measure 'Conversion Rate' = DIVIDE([Total Orders], [Total_Sessions], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: e1abfb56-4367-4784-a7a8-07ecadd69e5d

	measure 'Total Customers' = DISTINCTCOUNT('orders'[user_id])
		formatString: 0
		lineageTag: f737aad2-289b-4c57-9c72-11a70efa651e

	measure 'Repeat Customers' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('orders'[user_id]),
			        CALCULATE(COUNT('orders'[order_id])) > 1
			    )
			)
		formatString: 0
		lineageTag: abb8d6f3-1525-4539-84f5-c7a91e979c5f

	measure 'New Customers' = [Total Customers] - [Repeat Customers]
		formatString: 0
		lineageTag: c7d31d19-01d6-47e2-a148-6a6fd4e92b1a

	measure 'Net Profit' =
			
			VAR GrossRevenue = SUM('orders'[price_usd])
			VAR TotalCOGS = SUM('orders'[cogs_usd])
			VAR TotalRefunds = SUM('order_item_refunds'[refund_amount_usd])
			RETURN
			    (GrossRevenue - TotalCOGS) - TotalRefunds
		lineageTag: 713ea055-592d-4566-9d67-261850893ede

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column order_id
		dataType: int64
		formatString: 0
		lineageTag: f0933066-f969-4846-9741-4fd01731b51d
		summarizeBy: none
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

