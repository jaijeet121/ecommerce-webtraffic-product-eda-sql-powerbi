		dataType: dateTime
		formatString: General Date
		lineageTag: 38dc0b5d-fdbd-4852-847d-8afd199f9e15
		summarizeBy: none
		sourceColumn: created_at

		variation Variation
			isDefault
			relationship: 66ca2c0b-49a6-4169-99a4-0fc9af03ded4
